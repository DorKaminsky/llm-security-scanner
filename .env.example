# Local development environment variables
# Copy to .env and fill in values

# LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# App
ENVIRONMENT=local
LOG_LEVEL=DEBUG

# DynamoDB table names
SCANS_TABLE=scans
RESULTS_TABLE=results

# SQS
CHECKS_QUEUE_URL=http://localhost:4566/000000000000/checks-queue
RESULTS_QUEUE_URL=http://localhost:4566/000000000000/results-queue

# S3
REPORTS_BUCKET=llm-scanner-reports

# Cognito (local mock)
COGNITO_USER_POOL_ID=local_pool
COGNITO_CLIENT_ID=local_client
JWT_SECRET=local-dev-secret-change-in-production